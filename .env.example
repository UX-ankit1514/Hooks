# Copy to .env (never commit .env). All values are optional.
WORKFLOW_COPILOT_HOST=127.0.0.1
WORKFLOW_COPILOT_PORT=8787
# Empty = built-in mock router. Planned: https://workflow-copilot-ten.vercel.app/api/route
# Existing endpoint (adapter):        https://workflow-copilot-ten.vercel.app/api/analyze
# Local mock of the planned contract: http://127.0.0.1:8787/mock/api/route
WORKFLOW_COPILOT_API_URL=
WORKFLOW_COPILOT_API_STYLE=
WORKFLOW_COPILOT_API_KEY=
WORKFLOW_COPILOT_API_TIMEOUT=25
WORKFLOW_COPILOT_MAX_PROMPT_CHARS=8000
WORKFLOW_COPILOT_UPSTREAM_URL=https://api.anthropic.com
# auto | tty | dialog | auto-accept | never
WORKFLOW_COPILOT_CONFIRM_UI=auto
WORKFLOW_COPILOT_CONFIRM_TIMEOUT=30
WORKFLOW_COPILOT_LOG_PROMPTS=0
WORKFLOW_COPILOT_DISABLED=0
